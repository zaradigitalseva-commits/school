rules_version = '2';

// Super admin email — always has admin access
function isSuperAdmin() {
  return request.auth.token.email == 'ngogrant454@gmail.com';
}

// Check if the user's UID is in the authorizedAdmins collection
function isAuthorizedAdmin() {
  return isSuperAdmin()
    || exists(/databases/$(database)/documents/authorizedAdmins/$(request.auth.uid));
}

// Check if the user's UID is in the authorizedFaculty collection
function isAuthorizedFaculty() {
  return exists(/databases/$(database)/documents/authorizedFaculty/$(request.auth.uid));
}

// Check if user is either admin or faculty (staff)
function isStaff() {
  return isAuthorizedAdmin() || isAuthorizedFaculty();
}

service cloud.firestore {
  match /databases/{database}/documents {

    // School info — public read, admin write
    match /school/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAuthorizedAdmin();
    }

    // Announcements — public read, staff write
    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isStaff();
    }

    // Events — public read, staff write
    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isStaff();
    }

    // Teachers — public read, staff write
    match /teachers/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isStaff();
    }

    // Users — user can read own record and create/update own record
    // Admin can read all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAuthorizedAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && isAuthorizedAdmin();
    }

    // Authorized admins — admin can read/write
    match /authorizedAdmins/{uid} {
      allow read: if request.auth != null && isAuthorizedAdmin();
      allow create, delete: if request.auth != null && isAuthorizedAdmin();
      allow update: if false;
    }

    // Authorized faculty — admin can read/write
    match /authorizedFaculty/{uid} {
      allow read: if request.auth != null && (isAuthorizedAdmin() || isAuthorizedFaculty());
      allow create, delete: if request.auth != null && isAuthorizedAdmin();
      allow update: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
