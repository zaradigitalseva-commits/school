rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.email == 'ngogrant454@gmail.com';
    }

    function membershipId(uid, schoolId) {
      return uid + '_' + schoolId;
    }

    function activeMembership(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId)))
        && get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.schoolId == schoolId
        && get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.status == 'ACTIVE';
    }

    function isSchoolAdmin(schoolId) {
      return activeMembership(schoolId)
        && get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.role == 'school_admin';
    }

    function isTeacher(schoolId) {
      return activeMembership(schoolId)
        && get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.role == 'teacher';
    }

    function schoolMember(schoolId) {
      return isSchoolAdmin(schoolId) || isTeacher(schoolId);
    }

    function teacherAssigned(schoolId, className) {
      return isTeacher(schoolId)
        && className is string
        && get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.assignments is list
        && className in get(/databases/$(database)/documents/schoolMemberships/$(membershipId(request.auth.uid, schoolId))).data.assignments;
    }

    function isSchoolOwner(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid;
    }

    function liveSchool(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == 'LIVE';
    }

    match /users/{uid} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow update: if isPlatformAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'phone', 'updatedAt']));
      allow delete: if isPlatformAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'LIVE';

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'PENDING_PAYMENT'
        && request.resource.data.paymentStatus == 'PENDING'
        && request.resource.data.subscriptionStatus == 'PENDING'
        && !exists(/databases/$(database)/documents/schoolOwnerRegistrations/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/schoolOwnerRegistrations/$(request.auth.uid)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/schoolOwnerRegistrations/$(request.auth.uid)).data.schoolId == schoolId;

      allow update: if isPlatformAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'address', 'phone', 'email', 'whatsappNumber',
            'whatsappVerified', 'tagline', 'description', 'logoUrl',
            'heroImageUrl', 'principalName', 'principalMessage',
            'principalImageUrl', 'campusImages', 'totalStudents',
            'totalTeachers', 'foundedYear', 'updatedAt'
          ]));

      allow delete: if isPlatformAdmin();
    }

    match /schoolMemberships/{membershipId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));

      allow create: if isPlatformAdmin()
        || (signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'school_admin'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.schoolId is string
          && getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid)
        || (signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'school_admin'
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.schoolId is string
          && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
          && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.status == 'LIVE')
        || (signedIn()
          && request.resource.data.role == 'teacher'
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.schoolId is string
          && exists(/databases/$(database)/documents/teacherInvites/$(request.resource.data.schoolId + '_' + request.auth.token.email))
          && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.schoolId + '_' + request.auth.token.email)).data.email == request.auth.token.email
          && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.schoolId + '_' + request.auth.token.email)).data.schoolId == request.resource.data.schoolId
          && get(/databases/$(database)/documents/teacherInvites/$(request.resource.data.schoolId + '_' + request.auth.token.email)).data.status == 'PENDING');

      allow update: if isPlatformAdmin()
        || (signedIn()
          && resource.data.schoolId is string
          && isSchoolAdmin(resource.data.schoolId)
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.role in ['teacher', 'school_admin'])
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.schoolId is string
          && resource.data.role == 'school_admin'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.role == resource.data.role
          && resource.data.status != 'ACTIVE'
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'email', 'assignments', 'approvedAt', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/schools/$(resource.data.schoolId))
          && get(/databases/$(database)/documents/schools/$(resource.data.schoolId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/schools/$(resource.data.schoolId)).data.status == 'LIVE');

      allow delete: if isPlatformAdmin();
    }

    match /teacherInvites/{inviteId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && request.auth.token.email == resource.data.email)
        || (signedIn() && resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));
      allow create, update: if isPlatformAdmin()
        || (signedIn() && request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
      allow delete: if isPlatformAdmin()
        || (signedIn() && resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));
    }

    match /schoolOwnerRegistrations/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/schoolOwnerRegistrations/$(uid))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schoolId is string
        && getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /slugReservations/{slug} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schoolId is string
        && getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
      allow update: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId);
      allow delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));
    }

    match /announcements/{announcementId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
      allow update, delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId);
    }

    match /events/{eventId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
      allow update, delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId);
    }

    match /students/{studentId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
      allow update, delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId);
    }

    match /classes/{classId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
      allow update, delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId);
    }

    match /results/{resultId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId))
        || (request.resource.data.schoolId is string && teacherAssigned(request.resource.data.schoolId, request.resource.data.className));
      allow update: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId)
        || (resource.data.schoolId is string && teacherAssigned(resource.data.schoolId, resource.data.className)
            && request.resource.data.schoolId == resource.data.schoolId
            && teacherAssigned(request.resource.data.schoolId, request.resource.data.className));
      allow delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));
    }

    match /homework/{homeworkId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId))
        || (request.resource.data.schoolId is string && teacherAssigned(request.resource.data.schoolId, request.resource.data.className));
      allow update: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId))
        || (resource.data.schoolId is string && teacherAssigned(resource.data.schoolId, resource.data.className)
            && request.resource.data.schoolId == resource.data.schoolId
            && teacherAssigned(request.resource.data.schoolId, resource.data.className));
      allow delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));
    }

    match /attendance/{attendanceId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId))
        || (request.resource.data.schoolId is string && teacherAssigned(request.resource.data.schoolId, request.resource.data.className));
      allow update: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId))
        || (resource.data.schoolId is string && teacherAssigned(resource.data.schoolId, resource.data.className)
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.className == resource.data.className
            && teacherAssigned(resource.data.schoolId, request.resource.data.className));
      allow delete: if isPlatformAdmin()
        || (resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId));
    }

    match /gallery/{galleryId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create, update, delete: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
    }

    match /documents/{documentId} {
      allow read: if isPlatformAdmin()
        || (resource.data.schoolId is string && schoolMember(resource.data.schoolId))
        || (resource.data.schoolId is string && liveSchool(resource.data.schoolId));
      allow create, update, delete: if isPlatformAdmin()
        || (request.resource.data.schoolId is string && isSchoolAdmin(request.resource.data.schoolId));
    }

    match /platformSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isPlatformAdmin();
    }

    match /platformAds/{adId} {
      allow read: if resource.data.active == true || isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }

    match /rechargeRequests/{rechargeId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schoolId is string
        && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.amount in [300, 600, 900, 1200, 3000]
        && (
          (request.resource.data.amount == 300 && request.resource.data.days == 28) ||
          (request.resource.data.amount == 600 && request.resource.data.days == 56) ||
          (request.resource.data.amount == 900 && request.resource.data.days == 84) ||
          (request.resource.data.amount == 1200 && request.resource.data.days == 112) ||
          (request.resource.data.amount == 3000 && request.resource.data.days == 280)
        )
        && request.resource.data.utr is string
        && request.resource.data.utrNormalized is string;

      allow update: if isPlatformAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']));

      allow delete: if isPlatformAdmin();
    }

    match /utrReservations/{utr} {
      /*
       * Transaction duplicate-UTR check uses transaction.get(utrRef).
       * A missing document must be readable, otherwise Firestore
       * returns "Missing or insufficient permissions" before create.
       */
      allow get: if signedIn();
      allow list: if isPlatformAdmin();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schoolId is string
        && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
        && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == request.auth.uid;

      allow update, delete: if isPlatformAdmin();
    }

    match /wallets/{schoolId} {
      allow read: if isPlatformAdmin() || (signedIn() && isSchoolAdmin(schoolId));
      allow write: if isPlatformAdmin();
    }

    match /walletTransactions/{transactionId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.schoolId is string && isSchoolAdmin(resource.data.schoolId))
        || (signedIn() && resource.data.schoolId is string && isSchoolOwner(resource.data.schoolId));
      allow create, update, delete: if isPlatformAdmin();
    }

    match /subscriptions/{schoolId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && isSchoolAdmin(schoolId))
        || isSchoolOwner(schoolId);
      allow write: if isPlatformAdmin();
    }

    match /authorizedAdmins/{uid} {
      allow read, write: if isPlatformAdmin();
    }

    match /authorizedFaculty/{uid} {
      allow read, write: if isPlatformAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}