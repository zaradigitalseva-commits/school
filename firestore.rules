rules_version = '2';

function signedIn() {
  return request.auth != null;
}

function isPlatformAdmin() {
  return signedIn()
    && request.auth.token.email == 'ngogrant454@gmail.com';
}

function membershipId(schoolId) {
  return request.auth.uid + '_' + schoolId;
}

function schoolExists(schoolId) {
  return exists(
    /databases/$(database)/documents/schools/$(schoolId)
  );
}

function isSchoolOwner(schoolId) {
  return signedIn()
    && schoolExists(schoolId)
    && get(
      /databases/$(database)/documents/schools/$(schoolId)
    ).data.ownerUid == request.auth.uid;
}

function membershipExists(schoolId) {
  return exists(
    /databases/$(database)/documents/schoolMemberships/$(membershipId(schoolId))
  );
}

function hasActiveSchoolRole(schoolId, role) {
  return signedIn()
    && membershipExists(schoolId)
    && get(
      /databases/$(database)/documents/schoolMemberships/$(membershipId(schoolId))
    ).data.status == 'ACTIVE'
    && get(
      /databases/$(database)/documents/schoolMemberships/$(membershipId(schoolId))
    ).data.role == role;
}

function isSchoolAdmin(schoolId) {
  return isPlatformAdmin()
    || hasActiveSchoolRole(schoolId, 'school_admin');
}

function isTeacher(schoolId) {
  return hasActiveSchoolRole(schoolId, 'teacher');
}

function schoolIsLive(schoolId) {
  return schoolExists(schoolId)
    && get(
      /databases/$(database)/documents/schools/$(schoolId)
    ).data.status == 'LIVE';
}

service cloud.firestore {

  match /databases/{database}/documents {

    match /schools/{schoolId} {

      allow read: if isPlatformAdmin()
        || resource.data.status == 'LIVE'
        || isSchoolOwner(schoolId);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'PENDING_PAYMENT'
        && request.resource.data.slug is string
        && request.resource.data.name is string;

      allow update: if isPlatformAdmin()
        || (
          isSchoolOwner(schoolId)
          && resource.data.status == 'PENDING_PAYMENT'
          && request.resource.data.status == 'PENDING_PAYMENT'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.slug == resource.data.slug
        );

      allow delete: if isPlatformAdmin();
    }

    match /slugReservations/{slug} {

      allow read: if signedIn();

      allow create: if signedIn()
        && !exists(
          /databases/$(database)/documents/slugReservations/$(slug)
        )
        && request.resource.data.slug == slug
        && request.resource.data.schoolId is string
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/schools/$(request.resource.data.schoolId)
        ).data.ownerUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/schools/$(request.resource.data.schoolId)
        ).data.status == 'PENDING_PAYMENT'
        && getAfter(
          /databases/$(database)/documents/schools/$(request.resource.data.schoolId)
        ).data.slug == slug;

      allow update, delete: if isPlatformAdmin();
    }

    match /users/{uid} {

      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
        );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid;

      allow delete: if isPlatformAdmin();
    }

    match /schoolMemberships/{membershipDocId} {

      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && (
            request.auth.uid == resource.data.uid
            || isSchoolAdmin(resource.data.schoolId)
          )
        );

      allow create: if isPlatformAdmin()
        || (
          signedIn()
          && membershipDocId ==
             request.auth.uid + '_' + request.resource.data.schoolId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'school_admin'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.schoolId is string
          && getAfter(
            /databases/$(database)/documents/schools/$(request.resource.data.schoolId)
          ).data.ownerUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/schools/$(request.resource.data.schoolId)
          ).data.status == 'PENDING_PAYMENT'
        );

      allow update: if isPlatformAdmin()
        || (
          signedIn()
          && isSchoolAdmin(resource.data.schoolId)
          && resource.data.uid != request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.schoolId == resource.data.schoolId
        );

      allow delete: if isPlatformAdmin()
        || (
          signedIn()
          && isSchoolAdmin(resource.data.schoolId)
          && resource.data.uid != request.auth.uid
        );
    }

    match /platformSettings/{docId} {

      allow read: if true;

      allow create, update, delete: if isPlatformAdmin();
    }

    match /utrReservations/{utr} {

      allow read: if isPlatformAdmin();

      allow create: if signedIn()
        && request.resource.data.utrNormalized == utr
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schoolId is string
        && isSchoolOwner(request.resource.data.schoolId);

      allow update, delete: if false;
    }

    match /rechargeRequests/{id} {

      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.schoolId is string
        && isSchoolOwner(request.resource.data.schoolId)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.utrNormalized is string
        && getAfter(
          /databases/$(database)/documents/utrReservations/$(request.resource.data.utrNormalized)
        ).data.rechargeRequestId == request.resource.id
        && request.resource.data.amount
          in [300, 600, 900, 1200, 3000]
        && request.resource.data.days
          in [28, 56, 84, 112, 280];

      allow update: if isPlatformAdmin();

      allow delete: if isPlatformAdmin();
    }

    match /wallets/{schoolId} {

      allow read: if isPlatformAdmin()
        || isSchoolAdmin(schoolId);

      allow create, update, delete: if isPlatformAdmin();
    }

    match /walletTransactions/{id} {

      allow read: if isPlatformAdmin();

      allow create: if isPlatformAdmin();

      allow update, delete: if false;
    }

    match /subscriptions/{schoolId} {

      allow read: if isPlatformAdmin()
        || isSchoolAdmin(schoolId);

      allow create, update, delete: if isPlatformAdmin();
    }

    match /billingCycles/{id} {

      allow read: if isPlatformAdmin();

      allow create, update, delete: if false;
    }

    match /schoolContent/{docId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && schoolIsLive(resource.data.schoolId)
        )
        || (
          resource.data.schoolId is string
          && isSchoolAdmin(resource.data.schoolId)
        );

      allow create: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);

      allow update: if signedIn()
        && resource.data.schoolId is string
        && request.resource.data.schoolId == resource.data.schoolId
        && isSchoolAdmin(resource.data.schoolId);

      allow delete: if signedIn()
        && resource.data.schoolId is string
        && isSchoolAdmin(resource.data.schoolId);
    }

    match /students/{studentId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);

      allow update: if signedIn()
        && resource.data.schoolId is string
        && request.resource.data.schoolId == resource.data.schoolId
        && isSchoolAdmin(resource.data.schoolId);

      allow delete: if signedIn()
        && resource.data.schoolId is string
        && isSchoolAdmin(resource.data.schoolId);
    }

    match /classes/{classId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);

      allow update: if signedIn()
        && resource.data.schoolId is string
        && request.resource.data.schoolId == resource.data.schoolId
        && isSchoolAdmin(resource.data.schoolId);

      allow delete: if signedIn()
        && resource.data.schoolId is string
        && isSchoolAdmin(resource.data.schoolId);
    }

    match /results/{resultId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create, update: if signedIn()
        && request.resource.data.schoolId is string
        && (
          isSchoolAdmin(request.resource.data.schoolId)
          || isTeacher(request.resource.data.schoolId)
        );

      allow delete: if signedIn()
        && resource.data.schoolId is string
        && isSchoolAdmin(resource.data.schoolId);
    }

    match /homework/{homeworkId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && (
          isSchoolAdmin(request.resource.data.schoolId)
          || isTeacher(request.resource.data.schoolId)
        );
    }

    match /attendance/{attendanceId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && (
          isSchoolAdmin(request.resource.data.schoolId)
          || isTeacher(request.resource.data.schoolId)
        );
    }

    match /notices/{noticeId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && schoolIsLive(resource.data.schoolId)
        )
        || (
          resource.data.schoolId is string
          && isSchoolAdmin(resource.data.schoolId)
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);
    }

    match /events/{eventId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && schoolIsLive(resource.data.schoolId)
        )
        || (
          resource.data.schoolId is string
          && isSchoolAdmin(resource.data.schoolId)
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);
    }

    match /gallery/{galleryId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && schoolIsLive(resource.data.schoolId)
        )
        || (
          resource.data.schoolId is string
          && isSchoolAdmin(resource.data.schoolId)
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);
    }

    match /documents/{documentId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);
    }

    match /academicSessions/{sessionId} {

      allow read: if isPlatformAdmin()
        || (
          resource.data.schoolId is string
          && (
            schoolIsLive(resource.data.schoolId)
            || isSchoolAdmin(resource.data.schoolId)
            || isTeacher(resource.data.schoolId)
          )
        );

      allow create, update, delete: if signedIn()
        && request.resource.data.schoolId is string
        && isSchoolAdmin(request.resource.data.schoolId);
    }

    match /platformAds/{adId} {

      allow read: if true;

      allow create, update, delete: if isPlatformAdmin();
    }

    match /platformAnnouncements/{id} {

      allow read: if true;

      allow create, update, delete: if isPlatformAdmin();
    }

    match /auditLogs/{logId} {

      allow read: if isPlatformAdmin();

      allow create: if isPlatformAdmin();

      allow update, delete: if false;
    }

    match /supportRequests/{requestId} {

      allow read: if isPlatformAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isPlatformAdmin();

      allow delete: if isPlatformAdmin();
    }

    match /school/{docId} {

      allow read: if true;

      allow write: if isPlatformAdmin();
    }

    match /announcements/{docId} {

      allow read: if true;

      allow create, update, delete: if isPlatformAdmin();
    }

    match /teachers/{docId} {

      allow read: if true;

      allow create, update, delete: if isPlatformAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
